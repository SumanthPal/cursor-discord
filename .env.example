# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
CURSOR_API_KEY=

# Project aliases (Cloud Run / hosted). Locally you can mount projects.yaml instead.
# PROJECTS_JSON={"default":"instinct","projects":{"instinct":{"repo":"https://github.com/you/Instinct-2.0","branch":"main"}}}

# Admins (comma-separated user IDs): /setup channels, /grant and /revoke access,
# use any repo. Everyone else needs the CURSOR_ROLE_NAME role (given by /grant)
# and only gets the repos bound to the channel.
# If SUPERUSER_IDS and ALLOWED_USER_IDS are both empty, everyone is an admin.
# SUPERUSER_IDS=
# CURSOR_ROLE_NAME=Cursor Access

# Optional allowlists (comma-separated snowflakes).
# ALLOWED_USER_IDS lets extra non-admin users in without the role.
# ALLOWED_USER_IDS=
# ALLOWED_GUILD_IDS=

# Dev: register slash commands to one guild for instant updates (prod omits → global)
# DISCORD_GUILD_ID=

# Optional model override (default: composer-2.5)
# CURSOR_MODEL=composer-2.5

# After a PR opens, queue a cloud-agent follow-up that subscribes to GitHub PR
# events via cursor-subscriptions (pub/sub). Users can opt out with no-watch.
# WATCH_PR_EVENTS=true

# Optional path override for projects YAML inside the container
# PROJECTS_PATH=/app/projects.yaml

# Cloud Run sets PORT; local default 8080
# PORT=8080

# Deploy script only
# GCP_PROJECT=
# GCP_REGION=us-central1
