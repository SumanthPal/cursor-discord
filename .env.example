# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
CURSOR_API_KEY=

# Admins (comma-separated user IDs): set channel repos ("@Cursor use owner/repo here"),
# give access ("@Cursor give @someone access"), use any repo. Everyone else needs the
# CURSOR_ROLE_NAME role and only gets the repos set for the channel.
# If SUPERUSER_IDS and ALLOWED_USER_IDS are both empty, everyone is an admin.
# SUPERUSER_IDS=
# CURSOR_ROLE_NAME=Cursor Access

# Optional allowlists (comma-separated snowflakes).
# ALLOWED_USER_IDS lets extra non-admin users in without the role.
# ALLOWED_USER_IDS=
# ALLOWED_GUILD_IDS=

# Only needed if an older version registered dev slash commands to one guild:
# set it once so the bot removes them there.
# DISCORD_GUILD_ID=

# Optional model override (default: composer-2.5)
# CURSOR_MODEL=composer-2.5

# Cloud Run sets PORT; local default 8080
# PORT=8080

# Deploy script only
# GCP_PROJECT=
# GCP_REGION=us-central1
